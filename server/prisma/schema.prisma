// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int            @id @default(autoincrement())
  email           String         @unique
  username        String         @unique
  password        String
  role            Role           @default(USER)
  isEmailVerified Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  enrollments     Enrollment[]
  wordProgresses  WordProgress[]
  setting         Setting?
}

model Word {
  id         Int            @id @default(autoincrement())
  text       String
  language   Language
  meaning    String
  example    String?
  createdAt  DateTime       @default(now())
  progresses WordProgress[]
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  url         String   @unique
  level       String?
  createdAt   DateTime @default(now())

  tasks Task[]
}

model Task {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  options   String[]
  type      TaskType @default(MULTIPLE_CHOICE)
  createdAt DateTime @default(now())
  language Language @default(EN)

  video   Video? @relation(fields: [videoId], references: [id])
  videoId Int?

  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  level       String   @default("None")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  enrollments Enrollment[]
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseId   Int
  progress   Float    @default(0.0)
  user       User     @relation(fields: [userId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Setting {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  global_language Language @default(UA)
  curent_language Language @default(EN)
  purposes        String[] @default(["none"])
  current_level   String   @default("none")
}

model WordProgress {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int

  word   Word @relation(fields: [wordId], references: [id])
  wordId Int

  progress  Int     @default(0)
  isLearned Boolean @default(false)

  @@unique([userId, wordId])
}

enum Role {
  OWNER
  USER
  ADMIN
}

enum TaskType {
  MULTIPLE_CHOICE
  FILL_IN_THE_BLANK
  TRUE_FALSE
}

enum Language {
  EN
  UA
  DE
}
