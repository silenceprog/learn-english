// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int                @id @default(autoincrement())
  email           String             @unique
  username        String             @unique
  password        String
  role            Role               @default(USER)
  isEmailVerified Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  enrollments     Enrollment[]
  wordProgresses  WordTaskProgress[]
  courses         Course[]
  tasks           Task[]
  setting         Setting?
  deleteAt        DateTime?
  lastLoginAt     DateTime?
  provider        String?
}

model Word {
  id            Int                @id @default(autoincrement())
  text          String
  language      Language
  translate     String[]
  meaning       String[]
  example       String?
  partOfSpeech  String?
  createdAt     DateTime           @default(now())
  progresses    WordTaskProgress[]
  totalProgress Int                @default(0)
  isLearned     Boolean            @default(false)
  phonetic      String             @default("none")
  audio         String             @default("none")
  phoneticUS    String?
  audioUS       String?
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  url         String   @unique
  level       Level?
  createdAt   DateTime @default(now())
  tags        String[] @default([])

  tasks    Task[]
  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])
}

model Task {
  id          Int      @id @default(autoincrement())
  question    String
  answer      String
  options     String[]
  type        TaskType @default(MULTIPLE_CHOICE)
  score       Int?
  createdAt   DateTime @default(now())
  language    Language @default(EN)
  order       Int?
  explanation String?

  author   User? @relation(fields: [authorId], references: [id])
  authorId Int?

  video   Video? @relation(fields: [videoId], references: [id])
  videoId Int?

  course   Course? @relation(fields: [courseId], references: [id])
  courseId Int?
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  level       Level    @default(NONE)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[] @default([])

  tasks Task[]

  enrollments Enrollment[]
  videos      Video[]

  author   User? @relation(fields: [authorId], references: [id])
  authorId Int?
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseId   Int
  progress   Float    @default(0.0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Setting {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  global_language  Language  @default(UA)
  current_language Language  @default(EN)
  purposes         Purpose[] @default([NONE])
  current_level    Level     @default(NONE)
}

model WordTaskProgress {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wordId Int
  word   Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  taskType WordTaskType
  isPassed Boolean      @default(false)
  score    Int          @default(0)
  attempts Int          @default(0)

  @@unique([userId, wordId, taskType])
}

enum WordTaskType {
  TRANSLATION
  MATCHING
  LISTENING
}

enum Role {
  OWNER
  USER
  ADMIN
}

enum TaskType {
  MULTIPLE_CHOICE
  FILL_IN_THE_BLANK
  TRUE_FALSE
}

enum Language {
  EN
  UA
  DE
}

enum Purpose {
  NONE
  WORK
  TRAVEL
  EDUCATION
  SELF_DEV
  COMMUNICATION
  HOBBY
}

enum Level {
  NONE
  A1
  A2
  B1
  B2
  C1
  C2
}
